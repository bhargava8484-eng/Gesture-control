{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Gesture Studio",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["main.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MPLCONFIGDIR": "${workspaceFolder}/.matplotlib-cache"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
